{
  "name": "c4-zoom",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "oxlint --deny-warnings",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "hooks:install": "lefthook install"
  },
  "dependencies": {
    "elkjs": "^0.12.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@tailwindcss/vite": "^4.2.0",
    "@types/node": "^26.6.11",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.0",
    "lefthook": "^2.1.12",
    "lint-staged": "^16.4.0",
    "oxfmt": "^0.60.0",
    "oxlint": "^1.82.0",
    "tailwindcss": "^4.2.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^4.1.11"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "oxfmt",
      "oxlint --deny-warnings"
    ],
    "*.{html,css,json,yaml,yml}": "oxfmt"
  },
  "packageManager": "pnpm@10.34.5"
}

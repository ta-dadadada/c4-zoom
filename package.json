{
  "name": "c4-zoom",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @c4-zoom/viewer dev",
    "build": "pnpm -r build",
    "preview": "pnpm --filter @c4-zoom/viewer preview",
    "lint": "oxlint --deny-warnings",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "typecheck": "tsc --noEmit --allowImportingTsExtensions",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "hooks:install": "lefthook install",
    "samples:export": "sh scripts/export-samples.sh",
    "c4-zoom": "node packages/cli/bin/c4-zoom.mjs"
  },
  "devDependencies": {
    "@playwright/test": "catalog:",
    "@types/node": "catalog:",
    "lefthook": "catalog:",
    "lint-staged": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "oxfmt",
      "oxlint --deny-warnings"
    ],
    "*.{html,css,json,yaml,yml}": "oxfmt"
  },
  "packageManager": "pnpm@10.34.5"
}
